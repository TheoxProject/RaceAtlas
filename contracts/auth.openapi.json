{
  "openapi": "3.1.0",
  "info": {
    "title": "RaceAtlas private account HTTP API",
    "version": "1.0.0",
    "description": "C0 foundation only: CSRF bootstrap. Session and account-flow endpoints remain future C1/C2 milestones."
  },
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "accountCsrf",
        "summary": "Bootstrap a non-bearer CSRF proof bound to an HttpOnly nonce and current site-session cookie.",
        "description": "No-store. No email/session token is returned. Valid nonce is preserved across tabs. Accounts disabled or incomplete close this endpoint while public discovery remains available. Origin/FetchMetadata supplied cross-site are rejected.",
        "responses": {
          "200": {
            "description": "CSRF proof, never an account bearer. HttpOnly host-only nonce cookie; Secure with HTTPS canonical site, SameSite=Lax, Path=/.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfProof"
                }
              }
            }
          },
          "400": {
            "description": "Query parameters rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "403": {
            "description": "Origin or FetchMetadata rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "429": {
            "description": "Bounded admission or concurrency refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "503": {
            "description": "Accounts disabled/incomplete or storage unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CsrfProof": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "csrf_token",
          "expires_in"
        ],
        "properties": {
          "csrf_token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expires_in": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800
          }
        }
      },
      "AccountError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "fields",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unavailable",
              "forbidden",
              "limited",
              "invalid_request"
            ]
          },
          "message": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "maxItems": 0
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
