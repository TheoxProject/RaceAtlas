    "/api/v1/auth/register": {
      "post": {
        "operationId": "registerAccount",
        "description": "CSRF and exact canonical Origin required before work. Email addresses ASCII for registration/recovery requests. Proof targets its own account even under another account cookie. No email/session token in JSON.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "security": [
          {
            "CsrfProof": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Uniform for ordinary known/unknown/verified/limited/full/provider-error outcomes; no delivery promise.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid shape/new-password policy or generic invalid proof (absent/expired/replayed/version/purpose).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "403": {
            "description": "Origin/CSRF rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "413": {
            "description": "Body over 8192 bytes including middleware cache.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "429": {
            "description": "Independent HTTP admission/concurrency before account lookup.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "503": {
            "description": "Global configuration/storage/KDF failure, not a business refusal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          }
        }
      }
    },
