{
  "openapi": "3.1.0",
  "info": {
    "title": "RaceAtlas private account HTTP API",
    "version": "1.0.0",
    "description": "Cookie-only account sessions and proof-driven email workflows. No automatic login on confirmation/reset. Actual provider/domain/deployment activation remains separately gated."
  },
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "accountCsrf",
        "summary": "Bootstrap a non-bearer CSRF proof bound to an HttpOnly nonce and current site-session cookie.",
        "description": "No-store. No email/session token is returned. Valid nonce is preserved across tabs. Accounts disabled or incomplete close this endpoint while public discovery remains available. Origin/FetchMetadata supplied cross-site are rejected.",
        "responses": {
          "200": {
            "description": "CSRF proof, never an account bearer. HttpOnly host-only nonce cookie; Secure with HTTPS canonical site, SameSite=Lax, Path=/.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfProof"
                }
              }
            }
          },
          "400": {
            "description": "Query parameters rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "403": {
            "description": "Origin or FetchMetadata rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "429": {
            "description": "Bounded admission or concurrency refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "503": {
            "description": "Accounts disabled/incomplete or storage unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "loginAccount",
        "description": "Cookie identity only. Basic Authorization from outer private-preview middleware is permitted but never grants account identity. Passive 401 never clears cookies; no auto-login on password change. All responses no-store.",
        "responses": {
          "200": {
            "description": "Success; no session bearer in JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or invalid new-password policy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication rejected. Passive response does not modify cookies; GET csrf then fresh login can replace stale cookies.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "403": {
            "description": "CSRF/Origin rejected or valid session with wrong current password; cookies and sessions preserved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 8192 bytes, including pre-cached bodies.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "429": {
            "description": "Admission/concurrency refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "503": {
            "description": "Configuration or storage unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Exact canonical APP_BASE_URL origin, no Host/Forwarded fallback."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "CsrfProof": []
          }
        ]
      }
    },
