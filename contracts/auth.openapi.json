  "components": {
    "schemas": {
      "CsrfProof": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "csrf_token",
          "expires_in"
        ],
        "properties": {
          "csrf_token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expires_in": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800
          }
        }
      },
      "AccountError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "fields",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unavailable",
              "forbidden",
              "limited",
              "invalid_request",
              "authentication_failed",
              "reauthentication_failed",
              "invalid_password",
              "invalid_proof"
            ]
          },
          "message": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "maxItems": 0
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AccountProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "email": {
            "type": "string",
            "maxLength": 254
          }
        }
      },
      "CurrentAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account"
        ],
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountProfile"
          }
        }
      },
      "LoginSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account",
          "csrf_token",
          "expires_in"
        ],
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountProfile"
          },
          "csrf_token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expires_in": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800
          }
        }
      },
      "RequestAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "accepted",
            "type": "string"
          }
        },
        "description": "Request accepted conditionally; no promise of message dispatch or delivery and no account-existence signal."
      }
    },
    "securitySchemes": {
      "SiteSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-raceatlas-session",
        "description": "HTTPS canonical site host-only, Secure/HttpOnly/SameSite=Lax/Path=/. Server expiry authoritative. Never JSON or Authorization."
      },
      "LoopbackSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "raceatlas_session_dev",
        "description": "Only explicit local/test HTTP loopback configuration. Never enabled in production."
      },
      "CsrfProof": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Non-bearer proof returned by CSRF bootstrap, bound to signed HttpOnly nonce cookie and current session cookie. Required also before login."
      },
      "EmailProof": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Account-Proof",
        "description": "43 URL-safe characters read from email fragment by future UI; never query/JSON/log/storage. Does not grant a session."
      }
    }
  }
}
