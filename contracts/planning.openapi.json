          "200": {
            "description": "Static personal calendar, committed metadata and closed Session before response. All-day end-exclusive events. HEAD materializes metadata but sends no body. No-store; attachment raceatlas-planning.ics.",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string",
                  "const": "attachment; filename=\"raceatlas-planning.ics\""
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "text/calendar": {
                "schema": {
                  "type": "string",
                  "description": "RFC5545 UTF8 CRLF, <=75 octets per folded physical line. No METHOD/invites/remote resources. Bound to2MiB,1000 events,16KiB emitted text field. Metadata cache retained until account/scope purge, max10000 pairs."
                }
              }
            }
          }
        },
