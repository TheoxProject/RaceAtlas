{
  "openapi": "3.1.0",
  "info": {
    "title": "RaceAtlas private saved scopes",
    "version": "1.0.0",
    "description": "Private cookie-authenticated saved scopes and static personal planned/registered calendar. No implicit public-map filters. Registered is user-declared."
  },
  "paths": {
    "/api/v1/me/saved-entries": {
      "get": {
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "description": "Optional read-intent proof bound to HttpOnly nonce and current session cookie. If present, it must be valid, including on HEAD; empty/malformed/expired/mismatched proof returns403 before private data/ledger. Without this header existing GET clients are unchanged. Origin may be absent on reads, but a supplied Origin must be canonical. Cookie is the only bearer.",
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "security": [
          {
            "SiteSession": []
          },
          {
            "LoopbackSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Committed result; no session token, no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "planning.schema.json#/$defs/SavedList"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or invalid status after ownership check.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "planning.schema.json#/$defs/PlanningError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid session; passive, no cookie changes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "planning.schema.json#/$defs/PlanningError"
                }
              }
            }
          },
          "403": {
            "description": "Origin/CSRF rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "planning.schema.json#/$defs/PlanningError"
                }
              }
            }
          },
          "404": {
            "description": "Foreign/nonexistent/malformed target, same generic error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "planning.schema.json#/$defs/PlanningError"
                }
              }
            }
          },
          "413": {
            "description": "Creation/list/response/text limit exceeded, no truncation or partial commit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "planning.schema.json#/$defs/PlanningError"
                }
              }
            }
          },
          "429": {
            "description": "Independent admission/concurrency refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "planning.schema.json#/$defs/PlanningError"
                }
              }
            }
          },
          "503": {
            "description": "Accounts disabled/incomplete or storage unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "planning.schema.json#/$defs/PlanningError"
                }
              }
            }
          }
        }
      }
    },
