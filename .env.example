# PowerShell: set these variables explicitly; this file is not loaded automatically.
RACEATLAS_ENV=local
DATABASE_URL=postgresql+psycopg://raceatlas:raceatlas@127.0.0.1:5432/raceatlas_dev
# TEST_DATABASE_URL must target a disposable database, never development or production.
TEST_DATABASE_URL=postgresql+psycopg://raceatlas:raceatlas@127.0.0.1:5432/raceatlas_test

# Prepared PRIVATE PREVIEW launcher only; no remote service is activated by this file.
# Set RACEATLAS_ENV=production and PORT from the hosting environment when authorized.
# Replace DATABASE_URL there with a complete postgresql+psycopg URL containing:
# sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
# Never commit the actual remote URL, username, password or generated preview credentials.
# Generate a random PREVIEW_PASSWORD of at least 32 characters in a private secret manager.
PREVIEW_USERNAME=
PREVIEW_PASSWORD=
# Separate maintenance session only, never injected into the web service.
# Remote use/migration still requires explicit owner authorization.
MIGRATION_DATABASE_URL=

# Account email integration in preparation; development sends are simulated only.
# Desired initial site URL, to confirm at authorized deployment; independent of sender domain.
APP_BASE_URL=https://raceatlas.onrender.com
EMAIL_PROVIDER=development
RESEND_API_KEY=
EMAIL_FROM=
# Never set the desired no-reply@raceatlas.com sender before ownership/DNS verification.
# EMAIL_PROVIDER=resend requires a verified sender and separate real-send authorization.
